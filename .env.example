# Database (Aurora PostgreSQL via RDS Data API - matches frontend)
AWS_RDS_CLUSTER_ARN=arn:aws:rds:us-west-2:123456789:cluster:lifeledger
AWS_RDS_SECRET_ARN=arn:aws:secretsmanager:us-west-2:123456789:secret:lifeledger
AWS_RDS_DATABASE=lifeledger

# Database (direct connection - optional, for local dev)
DATABASE_URL=postgresql://user:password@aurora-endpoint:5432/lifeledger

# Azure OpenAI (GPT-4.1 VLM)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_KEY=your-api-key
AZURE_OPENAI_DEPLOYMENT=gpt-4.1

# AWS credentials (shared by S3, RDS Data API, Cognito)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-west-2

# AWS S3 (use same bucket as frontend)
AWS_S3_BUCKET=lifeledger-images

# AWS Cognito
COGNITO_POOL_ID=us-west-2_xxxxxxxxx
COGNITO_REGION=us-west-2

# CORS (Vercel frontend URL)
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# Development mode (set to "true" to bypass auth for testing)
DEV_MODE=false
